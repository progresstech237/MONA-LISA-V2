# ═══════════════════════════════════════════════════════════════════════════
#   🎨🧊🎵 STABILITY AI STUDIO
#   Powers .imagine .core .sd35 .upscale .upscalehd .upscalecreative
#         .removebg .outpaint .searchreplace .recolor .relight
#         .sketch2img .structure2img .styleguide .to3d .to3dhq
#         .genmusic .audio2audio
#   Get a key from https://platform.stability.ai
# ═══════════════════════════════════════════════════════════════════════════
STABILITY_API_KEY=sk-XDnocnve9YZUfjOzO4WUPFoNssuUilm0YNssBgr5mlfSOkRr
# Model slug used by .genmusic / .audio2audio. 'stable-audio-2' is
# confirmed/documented. Stability released Stable Audio 3.0 very recently —
# switch this to 'stable-audio-3' once you've verified that slug against
# https://platform.stability.ai/docs/api-reference yourself.
STABILITY_AUDIO_MODEL=stable-audio-2

# Note: Stability deprecated their own Stable Video Diffusion (image/text-to-
# video) API in July 2025 — that's why video generation below uses Replicate
# instead of Stability.
# ═══════════════════════════════════════════════════════════════════════════
#   🎬 VIDEO STUDIO — text-to-video / image-to-video (.genvideo .img2video)
#   Get a token from https://replicate.com/account/api-tokens, then set
#   REPLICATE_VIDEO_MODEL to whichever model version you have access to.
# ═══════════════════════════════════════════════════════════════════════════
REPLICATE_API_TOKEN=
# For .genvideo — text-to-video, no image needed. Confirmed field name
# ({ prompt }) via Replicate's own blog post: replicate.com/blog/wan-22
REPLICATE_T2V_MODEL=wan-video/wan-2.2-t2v-fast
# For .img2video — animates a photo you provide. Confirmed field names
# ({ image, prompt }) from the same blog post.
REPLICATE_I2V_MODEL=wan-video/wan-2.2-i2v-fast
# For .talkingavatar / .speak — a portrait + exact script → the person saying it.
# Recommended: prunaai/p-video-avatar (cheapest/fastest avatar model on Replicate,
# ~$0.025/sec at 720p). No version hash needed — "owner/model" resolves to the
# latest version automatically.
REPLICATE_AVATAR_MODEL=prunaai/p-video-avatar

